# Copia este archivo como .env y completa los valores.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/proyecto077
CORS_ORIGINS=http://localhost:5173
BANXICO_TOKEN=tu_token_aquí

# Clave con que se firma la cookie de sesión (HMAC-SHA256). Obligatoria y sin valor por
# omisión: sin ella la API no arranca. Debe tener 32 caracteres o más. Genérala con
#     uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# y pégala solo aquí, en .env. Cambiarla cierra todas las sesiones abiertas.
SESION_CLAVE=

# Caducidad absoluta de la sesión, en minutos (de 5 a 1440); no se renueva.
SESION_DURACION_MINUTOS=480

# Atributo Secure de la cookie: true solo si la API se sirve con HTTPS.
SESION_COOKIE_SEGURA=false
